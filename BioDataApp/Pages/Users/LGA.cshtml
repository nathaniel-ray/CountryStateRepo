@page
@model BioDataApp.Pages.Users.LGAModel
@{
}

<!-- I'm calling validateForm when the form submits -->
<!-- If it returns false the form stops and shows the errors -->
<!-- If it returns true the form submits normally to OnPostAsync -->
<form method="post" onsubmit="return validateForm()">
   
    <!-- Error Box -->
    <!-- This is hidden by default and only shows when validateForm finds errors -->
    <div id="errorBox" class="container mt-3 alert alert-danger d-none"></div>
    @* Page Header  *@
    <div class="bg-secondary bg-opacity-10 py-2 mb-5">
        <div class="container">
            <h1>Add LGA Information</h1>
        </div>
    </div>

    @* {{-- Validation Summary --}} *@
    @* {{-- If the user submits without selecting a country or state --}} *@
    @* {{-- the error message will appear here in red --}} *@
    <div class="container mt-3">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>

    @* {{-- Top Section: Country and State Dropdowns --}} *@
    <div class="mt-5">
        <div class="row g-4">

            @* {{-- Country Dropdown --}} *@
            @* {{-- Filled from Model.CountryList which I loaded in OnGetAsync --}} *@
            <div class="col-auto">
                <label for="countrySelect" class="col-form-label">Select Country</label>
            </div>
            <div class="col">
                <select class="form-control" asp-for="LGATab.CountryId" id="countrySelect">
                    <option selected value="0">--Select Country--</option>
                    @foreach (var item in Model.CountryList)
                    {
                        <option value="@item.Id">@item.CountryName</option>
                    }
                </select>
            </div>

            @* {{-- State Dropdown --}} *@
            @* {{-- This starts empty and gets filled by JavaScript --}} *@
            @* {{-- when the user selects a country above --}} *@
            <div class="col-auto">
                <label for="stateSelect" class="col-form-label">Select State</label>
            </div>
            <div class="col">
                <select class="form-control" asp-for="LGATab.StateId" id="stateSelect">
                    <option selected value="0">--Select State--</option>
                    {{-- States are loaded here dynamically via JavaScript fetch --}}
                </select>
            </div>

        </div>

        @* {{-- Save Button --}} *@
        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Save</button>
        </div>
    </div>

    @* {{-- LGA Table --}} *@
    @* {{-- Each row has an LGA Code input, LGA Name input and a Remove Row button --}} *@
    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">S/N</th>
                    <th scope="col">LGA Code</th>
                    <th scope="col">LGA Name</th>
                    <th scope="col" style="width: 120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @* {{-- I'm looping through LGAList which starts with 5 blank rows --}} *@
                @* {{-- The index i is important — ASP.NET needs it to correctly --}} *@
                @* {{-- map each row back to LGATab.LGAList[i] when the form submits --}} *@
                @for (int i = 0; i < Model.LGATab.LGAList.Count; i++)
                {
                    <tr>
                        <th scope="row">@(i + 1)</th>
                        <td>
                            <input asp-for="LGATab.LGAList[i].LGACode"
                                   type="text"
                                   class="form-control"
                                   placeholder="e.g LC001">
                        </td>
                        <td>
                            <input asp-for="LGATab.LGAList[i].LGAName"
                                   type="text"
                                   class="form-control"
                                   placeholder="e.g Ikeja">
                        </td>
                        <td class="p-1 text-center">
                            <button class="btn btn-danger btn-sm"
                                    type="button"
                                    onclick="removeRow(this)">
                                Remove Row
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* {{-- Table Action Buttons --}} *@
        <div class="row g-3 mt-3">
            <div class="col-auto">
                @* {{-- Add Row adds a blank row to the bottom of the table --}} *@
                <button class="btn btn-secondary" type="button" id="addRowBtn">Add row</button>
            </div>
            
            <div class="col-auto">
                <a href="/Users/List" class="btn btn-dark">Back to List</a>
            </div>
        </div>
    </div>

</form>

<partial name="_ValidationScriptsPartial" />

<script>
    // I'm counting how many rows are actually in the table when the page loads
    // This works whether OnGetAsync loads 0, 5, or any number of rows
    let rowCount = document.querySelectorAll('tbody tr').length;

    // removeRow: this runs when I click the Remove Row button on any row
    function removeRow(button) {
        // I'm climbing up the DOM from the button to find its parent <tr> row
        const row = button.closest('tr');
        row.remove();
        renumberRows();
    }

    // renumberRows: after removing a row I call this to fix the S/N numbers
    // so there are no gaps like 1, 2, 4, 5
    function renumberRows() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach((row, index) => {
            row.querySelector('th').textContent = index + 1;
        });
        rowCount = rows.length;
    }

    // addRowBtn: adds a new blank row with input fields to the bottom of the table
    document.getElementById('addRowBtn').addEventListener('click', function () {
        rowCount++;
        const tbody = document.querySelector('tbody');
        const index = rowCount - 1;
        const newRow = document.createElement('tr');
        newRow.innerHTML = `
            <th scope="row">${rowCount}</th>
            <td><input name="LGATab.LGAList[${index}].LGACode" type="text" class="form-control" placeholder="e.g LC001"></td>
            <td><input name="LGATab.LGAList[${index}].LGAName" type="text" class="form-control" placeholder="e.g Ikeja"></td>
            <td class="p-1 text-center">
                <button class="btn btn-danger btn-sm" type="button" onclick="removeRow(this)">Remove Row</button>
            </td>
        `;
        tbody.appendChild(newRow);
    });

    // countrySelect: when I change the country dropdown
    // I fetch the states that belong to that country
    // and fill the state dropdown with them dynamically
    document.getElementById('countrySelect').addEventListener('change', function () {
        const countryId = this.value;
        const stateSelect = document.getElementById('stateSelect');

        // I'm resetting the state dropdown while the fetch is running
        stateSelect.innerHTML = '<option value="0">--Select State--</option>';

        // I only fetch if a real country was selected
        if (countryId && countryId !== '0') {
            fetch(`/Users/LGA?handler=StatesByCountry&countryId=${countryId}`)
                .then(response => response.json())
                .then(states => {
                    states.forEach(state => {
                        const option = document.createElement('option');
                        option.value = state.id;
                        option.textContent = state.stateName;
                        stateSelect.appendChild(option);
                    });
                });
        }
    });

    // validateForm: I'm running this before the form submits
    // I'm checking everything on the frontend so the page never reloads
    // with broken dropdowns
    function validateForm() {
        // I'm clearing any old error messages from a previous submit attempt
        document.getElementById('errorBox').innerHTML = '';
        document.getElementById('errorBox').classList.add('d-none');

        let errors = [];

        // I'm checking if the user selected a country
        const countryId = document.getElementById('countrySelect').value;
        if (!countryId || countryId === '0') {
            errors.push('Please select a country before saving.');
        }

        // I'm checking if the user selected a state
        const stateId = document.getElementById('stateSelect').value;
        if (!stateId || stateId === '0') {
            errors.push('Please select a state before saving.');
        }

        // I'm checking if at least one row has been filled in
        // I loop through all rows and check if any input has a value
        const rows = document.querySelectorAll('tbody tr');
        let filledCount = 0;

        rows.forEach(row => {
            const inputs = row.querySelectorAll('input');
            // I'm checking if either the LGA Code or LGA Name input has a value
            const codeVal = inputs[0] ? inputs[0].value.trim() : '';
            const nameVal = inputs[1] ? inputs[1].value.trim() : '';
            if (codeVal !== '' || nameVal !== '') {
                filledCount++;
            }
        });

        if (filledCount === 0) {
            errors.push('Please fill in at least one LGA before saving.');
        }

        // If there are any errors I show them and stop the form from submitting
        if (errors.length > 0) {
            const errorBox = document.getElementById('errorBox');
            errorBox.classList.remove('d-none');
            // I'm building the error list and injecting it into the error box
            errorBox.innerHTML = '<ul class="mb-0">' +
                errors.map(e => `<li>${e}</li>`).join('') +
                '</ul>';

            // I'm returning false to stop the form from submitting
            return false;
        }

        // Everything passed — I'm allowing the form to submit
        return true;
    }
</script>