@page
@model BioDataApp.Pages.Users.LGAModel
@{
}

<!-- I'm calling validateForm when the form submits -->
<!-- If it returns false the form stops and shows the errors -->
<!-- If it returns true the form submits normally to OnPostAsync -->
<form method="post" onsubmit="return validateForm()">

    <!-- Page Header -->
    <div class="bg-secondary bg-opacity-10 py-2 mb-5">
        <div class="container">
            <h1>Add LGA Information</h1>
        </div>
    </div>

    <!-- Error Box -->
    <!-- This is hidden by default and only shows when validateForm finds errors -->
    <div id="errorBox" class="container mt-3 alert alert-danger d-none"></div>

    <!-- Success Box -->
    <!-- This is hidden by default and only shows after a successful save -->
    <!-- I'm checking Model.SaveSuccess which OnPostAsync sets to true after saving -->
    <!-- If SaveSuccess is true I remove the d-none class so the message appears -->
    <div id="successBox" class="container mt-3 alert alert-success @(Model.SaveSuccess ? "" : "d-none")">
        <strong>✓ LGA successfully saved!</strong>
        <!-- I'm giving the user a helpful next step after saving -->
        The LGA records have been saved to the database.
    </div>

    <!-- Country and State Dropdown Section -->
    <div class="mt-5">
        <div class="row g-4">

            <!-- Country Dropdown -->
            <!-- Filled from Model.CountryList which I loaded in OnGetAsync -->
            <!-- When I change this dropdown it triggers getStates() -->
            <!-- which fetches and fills the state dropdown with matching states -->
            <div class="col-auto">
                <label for="countrySelect" class="col-form-label">Select Country</label>
            </div>
            <div class="col">
                <!-- onchange fires getStates() to load states for the selected country -->
                <!-- asp-for binds this to LGATab.CountryId so the value is submitted -->
                <select class="form-control" onchange="getStates()"
                        asp-for="LGATab.CountryId" id="countrySelect">
                    <option value="0">--Select Country--</option>
                    @foreach (var item in Model.CountryList)
                    {
                        <!-- I'm pre-selecting the country that was stored in -->
                        <!-- LGATab.CountryId so the dropdown stays selected after save -->
                        <option value="@item.Id" selected='@(item.Id == Model.LGATab.CountryId ? "selected" : null)'>
                            @item.CountryName
                        </option>
                    }
                </select>
            </div>

            <!-- State Dropdown -->
            <!-- This is populated by getStates() when a country is selected -->
            <!-- When I change this dropdown it triggers getLGAs() -->
            <!-- which reloads the page with BOTH the stateId AND countryId in the URL -->
            <div class="col-auto">
                <label for="stateSelect" class="col-form-label">Select State</label>
            </div>
            <div class="col">
                <!-- onchange fires getLGAs() which redirects with stateId and countryId -->
                <!-- asp-for binds this to LGATab.StateId so the value is submitted -->
                <select class="form-control" onchange="getLGAs()"
                        asp-for="LGATab.StateId" id="stateSelect">
                    <option value="0">--Select State--</option>
                    <!-- I'm pre-populating from Model.StateList so the correct state -->
                    <!-- is already selected when the page reloads after a save -->
                    @foreach (var item in Model.StateList)
                    {
                        <option value="@item.Id" selected='@(item.Id == Model.LGATab.StateId ? "selected" : null)'>
                            @item.StateName
                        </option>
                    }
                </select>
            </div>

        </div>
    </div>

    <!-- LGA Table -->
    <!-- Each row has an LGA Code input, LGA Name input and a Remove Row button -->
    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">S/N</th>
                    <th scope="col">LGA Code</th>
                    <th scope="col">LGA Name</th>
                    <th scope="col" style="width: 120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <!-- I'm looping through LGAList -->
                <!-- After a save this shows the updated LGAs for the current state -->
                <!-- The index i is critical — ASP.NET uses it to map each row -->
                <!-- back to LGATab.LGAList[i] when the form submits -->
                @for (int i = 0; i < Model.LGATab.LGAList.Count; i++)
                {
                    <tr>
                        <th scope="row">@(i + 1)</th>
                        <td>
                            <input asp-for="LGATab.LGAList[i].LGACode"
                                   type="text"
                                   class="form-control"
                                   placeholder="e.g LC001">
                        </td>
                        <td>
                            <input asp-for="LGATab.LGAList[i].LGAName"
                                   type="text"
                                   class="form-control"
                                   placeholder="e.g Ikeja">
                        </td>
                        <td class="p-1 text-center">
                            <button class="btn btn-danger btn-sm"
                                    type="button"
                                    onclick="removeRow(this)">Remove Row</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Action Buttons -->
        <div class="row g-3 mt-3">
            <div class="col-auto">
                <!-- Add Row adds a blank input row to the bottom of the table -->
                <button class="btn btn-secondary" type="button" id="addRowBtn">Add row</button>
            </div>
            <div class="col-auto">
                <!-- Submit sends the whole form to OnPostAsync -->
                <button class="btn btn-success" type="submit">Submit</button>
            </div>
            <div class="col-auto">
                <a href="/Users/List" class="btn btn-dark">Back to List</a>
            </div>
        </div>
    </div>

</form>

<partial name="_ValidationScriptsPartial" />

<script>
    // I'm counting how many rows are actually in the table when the page loads
    // This works whether the page loaded with existing LGAs or blank rows
    let rowCount = document.querySelectorAll('tbody tr').length;

    // removeRow: this runs when I click the Remove Row button on any row
    function removeRow(button) {
        const row = button.closest('tr');
        row.remove();
        renumberRows();
    }

    // renumberRows: after removing a row I call this to fix the S/N numbers
    // so there are no gaps like 1, 2, 4, 5
    function renumberRows() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach((row, index) => {
            row.querySelector('th').textContent = index + 1;
        });
        rowCount = rows.length;
    }

    // getStates: this runs when I change the country dropdown
    // It fetches states for the selected country via AJAX
    // and fills the state dropdown with them dynamically
    function getStates() {
        const countrySelect = document.getElementById('countrySelect');
        const stateSelect = document.getElementById('stateSelect');

        // I'm resetting the state dropdown first while the fetch runs
        stateSelect.innerHTML = '<option value="0">--Select State--</option>';

        if (countrySelect.value && countrySelect.value !== '0') {
            fetch(`/Users/LGA?handler=StatesByCountry&countryId=${countrySelect.value}`)
                .then(response => response.json())
                .then(states => {
                    states.forEach(state => {
                        const option = document.createElement('option');
                        option.value = state.id;
                        option.textContent = state.stateName;
                        stateSelect.appendChild(option);
                    });
                });
        }
    }

    // getLGAs: this runs when I change the state dropdown
    // It reloads the page with BOTH the stateId AND countryId in the URL
    // Passing countryId is the key fix — without it the country dropdown
    // would clear on every reload and the validation would fail
    function getLGAs() {
        const stateSelect = document.getElementById('stateSelect');
        const countrySelect = document.getElementById('countrySelect');

        if (stateSelect.value && stateSelect.value !== '0') {
            // I'm passing BOTH id (stateId) AND countryId in the URL
            // so OnGetAsync can pre-select both dropdowns after the reload
            window.location.href = window.location.origin +
                '/Users/LGA?id=' + stateSelect.value +
                '&countryId=' + countrySelect.value;
        }
    }

    // restoreStateDropdown: this runs immediately when the page loads
    // If a country is already pre-selected from the URL I re-fetch its states
    // and rebuild the state dropdown then re-select the correct state
    // Without this the state dropdown would be empty on reload even though
    // a state is pre-selected on the server side
    function restoreStateDropdown() {
        const countrySelect = document.getElementById('countrySelect');
        const stateSelect = document.getElementById('stateSelect');

        if (countrySelect.value && countrySelect.value !== '0') {

            // I'm saving the currently selected stateId before rebuilding the dropdown
            // so I can re-select it after all the options are added back
            const selectedStateId = stateSelect.value;

            fetch(`/Users/LGA?handler=StatesByCountry&countryId=${countrySelect.value}`)
                .then(response => response.json())
                .then(states => {
                    stateSelect.innerHTML = '<option value="0">--Select State--</option>';

                    states.forEach(state => {
                        const option = document.createElement('option');
                        option.value = state.id;
                        option.textContent = state.stateName;

                        // I'm re-selecting the correct state after rebuilding the list
                        if (state.id == selectedStateId) {
                            option.selected = true;
                        }

                        stateSelect.appendChild(option);
                    });
                });
        }
    }

    // I'm calling restoreStateDropdown immediately when the page loads
    // so both dropdowns are fully restored after every reload
    restoreStateDropdown();

    // I'm auto-scrolling to the success box if it is visible
    // so the user doesn't have to scroll up to see the confirmation message
    // after clicking Submit
    window.addEventListener('load', function () {
        const successBox = document.getElementById('successBox');

        // I'm checking if the success box is currently visible
        // by seeing if it does NOT have the d-none class
        if (!successBox.classList.contains('d-none')) {
            // I'm smoothly scrolling the success message into view
            successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // I'm automatically hiding the success message after 5 seconds
            // so it doesn't permanently clutter the page
            setTimeout(() => {
                successBox.classList.add('d-none');
            }, 5000);
        }
    });

    // addRowBtn: when I click Add Row this creates a new blank row with input fields
    document.getElementById('addRowBtn').addEventListener('click', function () {
        rowCount++;
        const tbody = document.querySelector('tbody');
        const index = rowCount - 1;
        const newRow = document.createElement('tr');
        newRow.innerHTML = `
            <th scope="row">${rowCount}</th>
            <td>
                <input name="LGATab.LGAList[${index}].LGACode"
                       type="text"
                       class="form-control"
                       placeholder="e.g LC001">
            </td>
            <td>
                <input name="LGATab.LGAList[${index}].LGAName"
                       type="text"
                       class="form-control"
                       placeholder="e.g Ikeja">
            </td>
            <td class="p-1 text-center">
                <button class="btn btn-danger btn-sm"
                        type="button"
                        onclick="removeRow(this)">Remove Row</button>
            </td>
        `;
        tbody.appendChild(newRow);
    });

    // validateForm: I'm running this before the form submits
    // I'm checking everything on the frontend so the page never reloads
    // with broken or reset dropdowns
    function validateForm() {
        const errorBox = document.getElementById('errorBox');
        errorBox.innerHTML = '';
        errorBox.classList.add('d-none');

        // I'm also hiding the success box when a new submit attempt starts
        // so it doesn't show stale success messages from a previous save
        document.getElementById('successBox').classList.add('d-none');

        let errors = [];

        // I'm checking if the user selected a country
        const countryId = document.getElementById('countrySelect').value;
        if (!countryId || countryId === '0') {
            errors.push('Please select a country before saving.');
        }

        // I'm checking if the user selected a state
        const stateId = document.getElementById('stateSelect').value;
        if (!stateId || stateId === '0') {
            errors.push('Please select a state before saving.');
        }

        // I'm checking if at least one row has been filled in
        const rows = document.querySelectorAll('tbody tr');
        let filledCount = 0;

        rows.forEach(row => {
            const inputs = row.querySelectorAll('input');
            const codeVal = inputs[0] ? inputs[0].value.trim() : '';
            const nameVal = inputs[1] ? inputs[1].value.trim() : '';
            if (codeVal !== '' || nameVal !== '') {
                filledCount++;
            }
        });

        if (filledCount === 0) {
            errors.push('Please fill in at least one LGA before saving.');
        }

        if (errors.length > 0) {
            errorBox.classList.remove('d-none');
            errorBox.innerHTML = '<ul class="mb-0">' +
                errors.map(e => `<li>${e}</li>`).join('') +
                '</ul>';
            return false;
        }

        return true;
    }
</script>