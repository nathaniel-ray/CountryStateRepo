@page
@model BioDataApp.Pages.Users.EditBioModel
@{
}
<div class="bg-secondary bg-opacity-10 py-2 mb-5">
    <div class="container">
        <h1>Edit User</h1>
    </div>
</div>
<div class="container">

    @if (Model.Status != "")
    {
        <div class="alert @(Model.Status == "Saved Successfully" ? "alert-success" : "alert-danger")">
            @Model.Status
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="UserDataTab.Id" />

        <div class="mb-3">
            <label class="form-label">Title</label>
            <select class="form-control" asp-for="UserDataTab.Title">
                <option value="">--Select Title--</option>
                <option value="Mr.">Mister</option>
                <option value="Mrs.">Mrs</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Surname</label>
            <input type="text" asp-for="UserDataTab.LastName" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input type="text" asp-for="UserDataTab.FirstName" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Other Names</label>
            <input type="text" asp-for="UserDataTab.MiddleName" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" asp-for="UserDataTab.Email" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Gender</label>
            <select class="form-control" asp-for="UserDataTab.Gender">
                <option value="">--Select Option--</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input type="text" asp-for="UserDataTab.PhoneNumber" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Date of Birth</label>
            <input type="date" asp-for="UserDataTab.DateofBirth" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Address</label>
            <input type="text" asp-for="UserDataTab.Address" class="form-control">
        </div>

        <button type="submit" asp-page-handler="Save" class="btn btn-primary">Save Changes</button>
        <button type="submit" asp-page-handler="Delete" class="btn btn-danger ms-2"
                onclick="return confirm('Are you sure you want to delete this user?')">
            Delete
        </button>
        <a href="/Users/List" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>
<partial name="_ValidationScriptsPartial" />