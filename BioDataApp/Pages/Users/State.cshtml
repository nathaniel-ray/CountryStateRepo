@page
@model BioDataApp.Pages.Users.StateModel
@{
}

<!-- I'm calling validateForm when the form submits -->
<!-- If it returns false the form stops and shows the errors -->
<!-- If it returns true the form submits normally to OnPostAsync -->
<form method="post" onsubmit="return validateForm()">

    <!-- Page Header -->
    <div class="bg-secondary bg-opacity-10 py-2 mb-5">
        <div class="container">
            <h1>Add State Information</h1>
        </div>
    </div>

    <!-- Error Box -->
    <!-- This is hidden by default and only shows when validateForm finds errors -->
    <div id="errorBox" class="container mt-3 alert alert-danger d-none"></div>

    <!-- Success Box -->
    <!-- This is hidden by default and only shows after a successful save -->
    <!-- I'm checking Model.SaveSuccess which OnPostAsync sets to true after saving -->
    <!-- If SaveSuccess is true I remove the d-none class so the message appears -->
    <div id="successBox" class="container mt-3 alert alert-success @(Model.SaveSuccess ? "" : "d-none")">
        <strong>✓ State successfully saved!</strong>
        The state records have been saved to the database.
    </div>

    <!-- Country Dropdown Section -->
    <div class="mt-5">
        <div class="row g-4">

            <!-- Country Dropdown -->
            <!-- Filled from Model.CountryList which I loaded in OnGetAsync -->
            <div class="col-auto">
                <label for="countrySelect" class="col-form-label">Select Country</label>
            </div>
            <div class="col">
                <!-- asp-for binds this to StateTab.CountryId -->
                <!-- onchange fires getStates() to reload the page with the countryId -->
                <!-- I'm pre-selecting the country using StateTab.CountryId -->
                <!-- so the dropdown stays selected after a save -->
                <select class="form-control" onchange="getStates()"
                        asp-for="StateTab.CountryId" id="countrySelect">
                    <option value="0">--Select Country--</option>
                    @foreach (var item in Model.CountryList)
                    {
                        <!-- Fixed: place the conditional inside the attribute value to avoid C# in attribute declaration area -->
                        <option value="@item.Id" selected="@(item.Id == Model.StateTab.CountryId ? "selected" : null)">
                            @item.CountryName
                        </option>
                    }
                </select>
            </div>

        </div>
    </div>

    <!-- State Table -->
    <!-- Each row has a State Code input, State Name input and a Remove Row button -->
    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">S/N</th>
                    <th scope="col">State Code</th>
                    <th scope="col">State Name</th>
                    <th scope="col" style="width: 120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <!-- I'm looping through StateList -->
                <!-- After a save this shows the updated states for the current country -->
                <!-- The index i is critical — ASP.NET uses it to map each row -->
                <!-- back to StateTab.StateList[i] when the form submits -->
                @for (int i = 0; i < Model.StateTab.StateList.Count; i++)
                {
                    <tr>
                        <th scope="row">@(i + 1)</th>
                        <td>
                            <input asp-for="StateTab.StateList[i].StateCode"
                                   type="text"
                                   class="form-control"
                                   placeholder="e.g SC001">
                        </td>
                        <td>
                            <input asp-for="StateTab.StateList[i].StateName"
                                   type="text"
                                   class="form-control"
                                   placeholder="e.g Lagos">
                        </td>
                        <td class="p-1 text-center">
                            <button class="btn btn-danger btn-sm"
                                    type="button"
                                    onclick="removeRow(this)">Remove Row</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Action Buttons -->
        <div class="row g-3 mt-3">
            <div class="col-auto">
                <!-- Add Row adds a blank input row to the bottom of the table -->
                <button class="btn btn-secondary" type="button" id="addRowBtn">Add row</button>
            </div>
            <div class="col-auto">
                <!-- Submit sends the whole form to OnPostAsync -->
                <button class="btn btn-success" type="submit">Submit</button>
            </div>
            <div class="col-auto">
                <a href="/Users/List" class="btn btn-dark">Back to List</a>
            </div>
        </div>
    </div>

</form>

<partial name="_ValidationScriptsPartial" />

<script>
    // I'm counting how many rows are actually in the table when the page loads
    // This works whether the page loaded with existing states or blank rows
    let rowCount = document.querySelectorAll('tbody tr').length;

    // removeRow: this runs when I click the Remove Row button on any row
    function removeRow(button) {
        const row = button.closest('tr');
        row.remove();
        renumberRows();
    }

    // renumberRows: after removing a row I call this to fix the S/N numbers
    // so there are no gaps like 1, 2, 4, 5
    function renumberRows() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach((row, index) => {
            row.querySelector('th').textContent = index + 1;
        });
        rowCount = rows.length;
    }

    // getStates: this runs when I change the country dropdown
    // It reloads the page with the selected countryId in the URL
    // so OnGetAsync loads the existing states for that country into the table
    function getStates() {
        const countrySelect = document.getElementById('countrySelect');

        // I only redirect if a real country was selected not the default option
        if (countrySelect.value && countrySelect.value !== '0') {
            // I'm redirecting to the same State page but with the countryId in the URL
            // This causes OnGetAsync to run with the id parameter set
            // which loads the existing states for this country into the table
            window.location.href = window.location.origin +
                '/Users/State?id=' + countrySelect.value;
        }
    }

    // addRowBtn: when I click Add Row this creates a new blank row with input fields
    document.getElementById('addRowBtn').addEventListener('click', function () {
        rowCount++;
        const tbody = document.querySelector('tbody');

        // I'm using rowCount - 1 as the index in the input name attributes
        // ASP.NET model binding uses this index to know which row is which
        const index = rowCount - 1;

        const newRow = document.createElement('tr');
        newRow.innerHTML = `
            <th scope="row">${rowCount}</th>
            <td>
                <input name="StateTab.StateList[${index}].StateCode"
                       type="text"
                       class="form-control"
                       placeholder="e.g SC001">
            </td>
            <td>
                <input name="StateTab.StateList[${index}].StateName"
                       type="text"
                       class="form-control"
                       placeholder="e.g Lagos">
            </td>
            <td class="p-1 text-center">
                <button class="btn btn-danger btn-sm"
                        type="button"
                        onclick="removeRow(this)">Remove Row</button>
            </td>
        `;
        tbody.appendChild(newRow);
    });

    // validateForm: I'm running this before the form submits
    // I'm doing all validation here on the frontend so the page never
    // reloads and loses the dropdown selection
    function validateForm() {
        const errorBox = document.getElementById('errorBox');
        errorBox.innerHTML = '';
        errorBox.classList.add('d-none');

        // I'm also hiding the success box when a new submit attempt starts
        // so stale success messages from a previous save don't linger
        document.getElementById('successBox').classList.add('d-none');

        let errors = [];

        // I'm checking if the user selected a country
        const countryId = document.getElementById('countrySelect').value;
        if (!countryId || countryId === '0') {
            errors.push('Please select a country before saving.');
        }

        // I'm checking if at least one row has been filled in
        const rows = document.querySelectorAll('tbody tr');
        let filledCount = 0;

        rows.forEach(row => {
            const inputs = row.querySelectorAll('input');
            const codeVal = inputs[0] ? inputs[0].value.trim() : '';
            const nameVal = inputs[1] ? inputs[1].value.trim() : '';
            if (codeVal !== '' || nameVal !== '') {
                filledCount++;
            }
        });

        if (filledCount === 0) {
            errors.push('Please fill in at least one state before saving.');
        }

        if (errors.length > 0) {
            errorBox.classList.remove('d-none');
            errorBox.innerHTML = '<ul class="mb-0">' +
                errors.map(e => `<li>${e}</li>`).join('') +
                '</ul>';
            return false;
        }

        return true;
    }

    // I'm auto-scrolling to the success box if it is visible when the page loads
    // so the user doesn't have to scroll up to see the confirmation after saving
    window.addEventListener('load', function () {
        const successBox = document.getElementById('successBox');

        // I'm checking if the success box is currently visible
        if (!successBox.classList.contains('d-none')) {
            // I'm smoothly scrolling the success message into view
            successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // I'm automatically hiding the success message after 5 seconds
            // so it doesn't permanently clutter the page
            setTimeout(() => {
                successBox.classList.add('d-none');
            }, 5000);
        }
    });
</script>