 @page
@model BioDataApp.Pages.Users.AddBioModel
@{
}
<div class="bg-secondary bg-opacity-10 py-2 mb-5">
    <div class="container">
        <h1>Add Information</h1>
    </div>
</div>

<div>
    <div class="container">
        <form method="post">
            <div class="mb-3">
                <label for="Title" class="form-label">Title</label>
                <select class="form-control" asp-for="UserDataTab.Title">
                    <option selected value="">--Select Title--</option>
                    <option value="Mr.">Mister</option>
                    <option value="Mrs.">Mrs</option>
                </select>
                <span asp-validation-for="UserDataTab.Title" class="danger"></span>
            </div>

            <div class="mb-3">
                <label for="SurName" class="form-label">Surname</label>
                <input type="text" asp-for="UserDataTab.LastName" class="form-control" id="SurName">
                <input type="hidden" asp-for="UserDataTab.Id" id="id">
                <span asp-validation-for="UserDataTab.Title" class="danger"></span>
            </div>

            <div class="mb-3">
                <label for="FirstName" class="form-label">First Name</label>
                <input type="text" asp-for="UserDataTab.FirstName" class="form-control" id="FirstName">
            </div>

            <div class="mb-3">
                <label for="OtherName" class="form-label">Other Names</label>
                <input type="text" asp-for="UserDataTab.MiddleName" class="form-control" id="OtherName">
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <input type="email" asp-for="UserDataTab.Email" class="form-control" id="Email">
            </div>

            <div class="mb-3">
                <label for="Phone" class="form-label">Gender</label>
                <select class="form-control" asp-for="UserDataTab.Gender">
                    <option selected value="">--Select Option--</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="Phone" class="form-label">Phone Number</label>
                <input type="text" asp-for="UserDataTab.PhoneNumber" class="form-control" id="Phone">
            </div>

            <div class="mb-3">
                <label for="Date_of_Birth" class="form-label">Date of Birth</label>
                <input type="date" asp-for="UserDataTab.DateofBirth" class="form-control" id="Date_of_Birth">
            </div>

            <div class="mb-3">
                <label for="Address" class="form-label">Address</label>
                <input type="text" asp-for="UserDataTab.Address" class="form-control" id="Address">
            </div>

            @*  <div class="mb-3">
                <label for="City" class="form-label">City</label>
                <input type="text" class="form-control" id="City">
            </div>

            <div class="mb-3">
                <label for="Country" class="form-label">Country</label>
                <input type="text" class="form-control" id="Country">
            </div> *@

            <div class="mb-3">
                <button class="btn btn-primary" type="submit">Submit</button>
                <a href="/Users/List" class="btn btn-dark ">Back to List</a>
            </div>
        </form>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
