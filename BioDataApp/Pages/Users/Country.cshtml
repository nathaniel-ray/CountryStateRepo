@page
@model BioDataApp.Pages.Users.CountryModel
@{
}

<form method="post">


<div class="bg-secondary bg-opacity-10 py-2 mb-5">
    <div class="container">
        <h1>Add Country Information</h1>
    </div>
</div>


<div class="mt-5">
    <div class="row g-4">
        
        <div class="col-auto">
            <label for="countryCode" class="col-form-label">Country Code </label>
        </div>
        <div class="col">
            <input type="hidden" asp-for="CountryTab.Id" id="id">
            <input type="text" asp-for="CountryTab.CountryCode" id="countryCode" class="form-control" placeholder="country code e.g +234" aria-label="code">
        </div>

        
        <div class="col-auto">
            <label for="countryName" class="col-form-label"> Input Country</label>
        </div>
        <div class="col">
            <input asp-for="CountryTab.CountryName" type="text" id="countryName" class="form-control" placeholder="country e.g Brazil" aria-label="country">
        </div>
    </div>

    
    <div class="mt-3">
        <button class="btn btn-primary" type="submit" id="">Save</button>
            <div class="col-auto ">
                <a href="/Users/List" class="btn btn-dark ">Back to List</a>
            </div>
    </div>
</div>

@if (Model.CountryList.Count > 0)
    {
    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">Action</th>
                    <th scope="col">S/N</th>
                    <th scope="col">Code</th>
                    <th scope="col">Country</th>
                    <th scope="col" style="width: 120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.CountryList.Count; i++)
                {
                    var item = Model.CountryList[i];    
                    <tr>
                        <td class="p-1 text-center">
                            <input type="hidden" value="@item.Id" class="idRow @i" />
                            <button class="btn btn-primary btn-sm" type="button" onclick="editRow(this)">Select</button>
                        </td>
                        <th scope="row">@(i+1)</th>
                        <td class="codeRow">@item.CountryCode</td>
                        <td class="nameRow">@item.CountryName</td>
                        <td class="p-1 text-center">
                            <button class="btn btn-danger btn-sm" type="button" onclick="removeRow(this)">Remove Row</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</form>

<partial name="_ValidationScriptsPartial" />

<script>
    //  this Tracks the total number of rows in the table
    // It Starts at 3 because there are 3 hardcoded rows already in the table
    let rowCount = 3;

    // removeRow: removes the row that contains the clicked "Remove Row" button
    // 'button' refers to whichever Remove Row button was clicked
    function removeRow(button) {
        // closest('tr') travels up the DOM to find the parent row of the clicked button
        const row = button.closest('tr');

        // Removes that row from the table
        row.remove();

        // After removing, re-number all remaining rows so S/N stays in order
        renumberRows();
    }

    function editRow(button) {
        // closest('tr') travels up the DOM to find the parent row of the clicked button
        const row = button.closest('tr');
        //Get values
        const idRow = row.querySelector('.idRow').value;
        const nameRow = row.querySelector('.nameRow').textContent.trim();
        const codeRow = row.querySelector('.codeRow').textContent.trim();
     
        document.getElementById('countryCode').value = codeRow;
        document.getElementById('countryName').value = nameRow;
        document.getElementById('id').value = idRow;

        
    };
    // renumberRows: loops through all rows and updates the S/N column
    // This ensures numbering stays correct after a row is removed
    function renumberRows() {
        // Get all current rows inside tbody
        const rows = document.querySelectorAll('tbody tr');

        // Loop through each row and update its S/N number
        // 'index' starts at 0 so we add 1 to make it start from 1
        rows.forEach((row, index) => {
            row.querySelector('th').textContent = index + 1;
        });

        // Update rowCount to match the current number of rows
        rowCount = rows.length;
    }

    // findFirstEmptyRow: scans the table to find the first row where
    // both the Code and Country cells are empty
    // Returns the empty row if found, or null if no empty row exists
    function findFirstEmptyRow() {
        const rows = document.querySelectorAll('tbody tr');

        for (let row of rows) {
            // Get the td cells in this row (excludes the th S/N cell)
            const cells = row.querySelectorAll('td');
            const codeCell = cells[0];       // First td = Code column
            const countryCell = cells[1];    // Second td = Country column

            // Check if both cells are empty (no text inside them)
            if (codeCell.textContent.trim() === '' && countryCell.textContent.trim() === '') {
                return row; // Return this empty row so Save can fill it
            }
        }

        // No empty row was found
        return null;
    }

    // Save Button: reads values from the input fields and adds them to the table
    document.getElementById('saveBtn').addEventListener('click', function () {

        // Read and trim whitespace from both input fields
        const code = document.getElementById('countryCode').value.trim();
        const country = document.getElementById('countryName').value.trim();

        // If both fields are empty, do nothing and stop here
        if (code === '' && country === '') return;

        // Check if there is already a blank row waiting to be filled
        const emptyRow = findFirstEmptyRow();

        if (emptyRow) {
            // An empty row exists — fill its Code and Country cells with the typed values
            const cells = emptyRow.querySelectorAll('td');
            cells[0].textContent = code;      // Fill the Code cell
            cells[1].textContent = country;   // Fill the Country cell
        } else {
            // No empty row found — create a brand new row with the typed values
            rowCount++;
            const tbody = document.querySelector('tbody');
            const newRow = document.createElement('tr');
            newRow.innerHTML = `
                <th scope="row">${rowCount}</th>
                <td>${code}</td>
                <td>${country}</td>
                <td class="p-1 text-center">
                    <button class="btn btn-danger btn-sm" type="button" onclick="removeRow(this)">Remove Row</button>
                </td>
            `;
            tbody.appendChild(newRow); // Add the new row to the bottom of the table
        }

        // Clear both input fields after saving so they are ready for new input
        document.getElementById('countryCode').value = '';
        document.getElementById('countryName').value = '';
    });

    // Add Row Button: adds a completely blank row to the bottom of the table
    // This blank row can later be filled using the Save button
    document.getElementById('addRowBtn').addEventListener('click', function () {
        rowCount++;
        const tbody = document.querySelector('tbody');
        const newRow = document.createElement('tr');
        newRow.innerHTML = `
            <th scope="row">${rowCount}</th>
            <td></td>
            <td></td>
            <td class="p-1 text-center">
                <button class="btn btn-danger btn-sm" type="button" onclick="removeRow(this)">Remove Row</button>
            </td>
        `;
        tbody.appendChild(newRow); // Attach the blank row to the table
    });
</script>